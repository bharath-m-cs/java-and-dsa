F1. `Employee(id, name, salary, department)` — employees earning more than their department's average salary. Solve BOTH ways (JOIN and correlated subquery).
- F2. Employees earning more than the company-wide average (no self-join needed here — why not?).
- F3. `Orders(order_id, customer_id, amount)` — orders above the customer's own average order amount.
- F4. Employees whose salary equals the max in their department.
- F5. Departments where at least one employee earns more than 2× the department average.


answers

1.



select f.name
from employee f
join
(



select department , AVG(salary) as avg_sal
from employee
group by department

)
e
on f.department=e.department
where f.salary > e.avg_sal;


2.
select e.name
from employee e
where e.salary >
(select AVG(f.salary)
from employee f
);


3.SELECT o.order_id, o.customer_id, o.amount
  FROM Orders o
  WHERE o.amount > (
      SELECT AVG(x.amount)
      FROM Orders x
      WHERE x.customer_id = o.customer_id
  );


  4.


  select e.name
  from employee e
  where e.salary =
  (

  select MAX(x.salary) as sal
  from employee x
  where e.department =x.department
  );

5.


select e.department
from employee e
where e.salary >
(


select 2*AVG(x.salary) as avg_sal
from employee x
where e.department =x.department
);
